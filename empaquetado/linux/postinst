#!/bin/sh
# Mantenimiento de menú e iconos del sistema mediante triggers de dpkg.
# Este script NUNCA toca $HOME ni los datos del usuario (RF-E13).
set -e
case "$1" in
    configure)
        if command -v dpkg-trigger >/dev/null 2>&1; then
            dpkg-trigger --no-await /usr/share/applications
            dpkg-trigger --no-await /usr/share/icons/hicolor
        fi
        ;;
    abort-upgrade | abort-remove | abort-deconfigure) ;;
    *)
        echo "postinst: argumento no reconocido: $1" >&2
        exit 1
        ;;
esac
exit 0
